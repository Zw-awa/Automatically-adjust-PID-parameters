{
  "$schema": "https://neutralino.js.org/schemas/neutralino.config.schema.json",
  "applicationId": "com.zwawa.pidlab",
  "defaultMode": "window",
  "port": 0,
  "url": "/",
  "modes": {
    "window": {
      "title": "PID Experimental Lab",
      "width": 1560,
      "height": 980,
      "minWidth": 1200,
      "minHeight": 760,
      "center": true,
      "icon": ""
    }
  },
  "server": {
    "url": "http://127.0.0.1:8765/lab/",
    "listen": false
  },
  "nativeAllowList": [
    "app.*",
    "events.*",
    "filesystem.*",
    "os.*",
    "window.*"
  ]
}
